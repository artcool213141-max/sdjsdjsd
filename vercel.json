{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/img/(.*)",
      "destination": "/img/$1"
    },
    {
      "src": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|css|js)",
      "destination": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
